# Universe 647 — Phase 4: Sophon (AI Brain)
# Copy to .env, fill in values, then run: make encrypt

# ==============================================================================
# Global (must match stacks/core/.env)
# ==============================================================================

DOMAIN=home.yourdomain.com
TZ=America/Los_Angeles
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_MUST_MATCH_CORE

# ==============================================================================
# Bifrost (LLM API Gateway)
# ==============================================================================

# Virtual key clients use to authenticate with the gateway
# Generate: echo "sk-bf-$(openssl rand -hex 24)"
BIFROST_VK=CHANGE_ME_GENERATE_KEY

# AES-256 key encrypting provider keys at rest in the config store
# Generate: openssl rand -base64 32 | tr -d '\n'
BIFROST_ENCRYPTION_KEY=CHANGE_ME_GENERATE_KEY

# Dashboard/admin-API credentials (UI on port 8080, ai_net only)
BIFROST_ADMIN_USERNAME=admin
BIFROST_ADMIN_PASSWORD=CHANGE_ME_GENERATE_PASSWORD

# Google Gemini API Key (tool-caller + embeddings)
# Create at: https://aistudio.google.com/apikey
GEMINI_API_KEY=CHANGE_ME_GEMINI_API_KEY

# Anthropic API Key (for smart model)
# Create at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=CHANGE_ME_ANTHROPIC_API_KEY
