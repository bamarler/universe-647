{
  "$comment": "Bifrost gateway config. Entities here are content-hash-seeded into the SQLite config store (/app/data/config.db) at startup: edit this file + restart and the file version wins; UI edits to other entities persist. Clients call http://bifrost:8080/openai/v1 with the BIFROST_VK virtual key as a Bearer token and request models by alias (tool-caller, smart, gemini-embedding-001).",
  "client": {
    "enable_logging": false,
    "enforce_auth_on_inference": true
  },
  "providers": {
    "gemini": {
      "keys": [
        {
          "name": "gemini-primary",
          "value": "env.GEMINI_API_KEY",
          "models": ["tool-caller", "gemini-3.1-flash-lite", "gemini-embedding-001"],
          "weight": 1.0,
          "aliases": {
            "tool-caller": "gemini-3.1-flash-lite"
          }
        }
      ]
    },
    "anthropic": {
      "keys": [
        {
          "name": "anthropic-primary",
          "value": "env.ANTHROPIC_API_KEY",
          "models": ["smart", "claude-haiku-4-5"],
          "weight": 1.0,
          "aliases": {
            "smart": "claude-haiku-4-5"
          }
        }
      ]
    }
  },
  "governance": {
    "virtual_keys": [
      {
        "id": "vk-default",
        "name": "homelab-clients",
        "value": "env.BIFROST_VK",
        "is_active": true,
        "provider_configs": [
          { "provider": "gemini", "allowed_models": ["*"], "key_ids": ["*"], "weight": 1 },
          { "provider": "anthropic", "allowed_models": ["*"], "key_ids": ["*"], "weight": 1 }
        ]
      }
    ],
    "auth_config": {
      "admin_username": "env.BIFROST_ADMIN_USERNAME",
      "admin_password": "env.BIFROST_ADMIN_PASSWORD"
    }
  },
  "config_store": {
    "enabled": true,
    "type": "sqlite",
    "config": { "path": "/app/data/config.db" }
  },
  "logs_store": { "enabled": false }
}
