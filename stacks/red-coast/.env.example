# Universe 647 — red-coast (movie/TV streaming)
# Copy to .env, fill in values, then run: make encrypt

# ==============================================================================
# Global
# ==============================================================================

TZ=America/New_York
PUID=1000
PGID=1000

# Intel QuickSync render group GID on the host (for Jellyfin hardware transcode)
# Verify on the server: getent group render | cut -d: -f3
RENDER_GID=989

# ==============================================================================
# Gluetun / NordVPN (WireGuard)
# ==============================================================================

# NordVPN WireGuard private key. Extract once (see docs/REMOTE-ACCESS.md runbook
# or: run NordVPN's nordlynx setup and read the wg private key), then make encrypt.
NORD_WG_KEY=CHANGE_ME_NORD_WIREGUARD_KEY

# Comma-separated P2P-friendly country/countries for gluetun server selection
NORD_COUNTRIES=Netherlands
